# --- Clerk (Auth) ---
# From https://dashboard.clerk.com -> your app -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/portal
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/portal

# --- Stripe (Payments) ---
# From https://dashboard.stripe.com -> Developers -> API Keys
STRIPE_SECRET_KEY=
# From `stripe listen` locally, or the Stripe Dashboard webhook endpoint in production
STRIPE_WEBHOOK_SECRET=
# The Price ID for the $997 one-time Better Than BNB product
STRIPE_PRICE_ID=

# --- Database (Postgres, e.g. Vercel Postgres / Neon) ---
DATABASE_URL=
DIRECT_URL=

# --- Admin ---
# Comma-separated list of emails allowed to view /admin
ADMIN_EMAILS=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
